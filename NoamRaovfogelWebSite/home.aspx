<%-- שורת ההגדרה של הדף: מקשרת ל-MasterPage, קובעת את כותרת הלשונית, ומפנה לקובץ השרת home.aspx.cs --%>
<%@ Page Title="דף הבית" Language="C#" MasterPageFile="~/MasterPage.master" AutoEventWireup="true" CodeFile="home.aspx.cs" Inherits="home" %>

<%-- פקד תוכן המתחבר ל-ContentPlaceHolder של ה-head בדף האב, משמש להזרקת עיצובים (CSS) המיוחדים רק לדף הבית --%>
<asp:Content ID="Content1" ContentPlaceHolderID="head" Runat="Server">
    <style>
        /* קופסת התוכן המרכזית - משנים אותה לרקע כהה שקוף כדי שהכתב הלבן יבלוט בטירוף */
        .home-container {
            text-align: center; /* מרחז את כל התוכן (טקסט ותמונות) בתוך הקופסה */
            padding: 20px; /* מרווח פנימי ראשוני */
            background-color: rgba(0, 0, 0, 0.6); /* רקע שחור שקוף ועדין (60% אטימות) שמאפשר לראות את ה-blend מאחור */
            border-radius: 12px; /* עיגול פינות הקופסה ברדיוס של 12 פיקסלים */
            padding: 30px; /* דריסת המרווח הפנימי למרווח גדול ומרווח יותר של 30 פיקסלים */
            box-shadow: 0 4px 20px rgba(0,0,0,0.5); /* צל כהה המעניק אפקט של עומק ותלת-ממד מעל הרקע */
        }

        /* כותרת ראשית בזהב של בארסה */
        .welcome-title {
            color: #edbb00; /* צבע זהב ברצלונה הרשמי */
            font-size: 34px; /* גודל גופן גדול ובולט למשיכת תשומת לב */
            margin-bottom: 10px; /* רווח חיצוני קטן בין הכותרת לתת-הכותרת */
            text-shadow: 2px 2px 4px rgba(0,0,0,0.8); /* צל שחור חזק מאחורי האותיות לשיפור הקריאות */
        }

        /* תת כותרת בלבן נקי */
        .subtitle {
            font-size: 19px; /* גודל גופן בינוני */
            color: #ffffff; /* צבע לבן נקי */
            margin-bottom: 25px; /* רווח חיצוני מתחת לתת-הכותרת לפני תמונת הבאנר */
        }

        /* כותרות משניות באדום של בארסה, עם קו תחתון בזהב */
        .section-title {
            color: #ff3366; /* אדום בהיר ובולט יותר על רקע כהה */
            font-size: 24px; /* גודל גופן לכותרות המשניות של פסקאות המידע */
            border-bottom: 2px solid #edbb00; /* קו תחתון דק בצבע זהב המשמש כאלמנט עיצובי מפריד */
            padding-bottom: 5px; /* רווח קטן בין הטקסט של הכותרת לקו הזהב שמתחתיה */
            text-align: right; /* יישור הטקסט של הכותרת לצד ימין (מתאים לעברית) */
            margin-top: 30px; /* רווח חיצוני מעל הכותרת כדי להרחיק אותה מהפסקה הקודמת */
        }

        /* פסקאות בכתב לבן וקריא */
        .info-text {
            font-size: 16px; /* גודל גופן סטנדרטי לקריאה נוחה של פסקאות */
            line-height: 1.6; /* מרווח שורות של 160% המונע מהשורות להיות צפופות מדי */
            text-align: right; /* יישור פסקאות המידע לימין */
            color: #ffffff; /* לבן מלא שרואים מצוין על הרקע השחור השקוף */
        }

        /* התיקון של התמונה: רואים את כולה ב-100% בלי חיתוכים */
        .home-banner {
            width: 100%; /* התמונה תתפרס על פני כל הרוחב הזמין של הקופסה */
            height: auto; /* מאפשר לתמונה לגדול בצורה טבעית ולשמור על יחס הגובה-רוחב המקורי שלה */
            max-height: 400px; /* הגבלת הגובה המקסימלי של התמונה ל-400 פיקסלים כדי שלא תתפוס את כל המסך */
            object-fit: contain; /* פקודת הקסם: מציגה את התמונה השלמה בתוך הגבולות בלי למתוח או לחתוך אותה */
            border-radius: 8px; /* עיגול עדין של פינות התמונה */
            margin: 20px 0; /* רווח חיצוני של 20 פיקסלים מלמעלה ומלמטה כדי להפריד אותה מהטקסטים */
        }

        /* הרשימה בכתב לבן */
        .barca-list {
            text-align: right; /* יישור נקודות הרשימה (הבולטים) וטקסט הרשימה לימין */
            font-size: 16px; /* גודל גופן התואם לפסקאות המידע */
            line-height: 1.8; /* מרווח שורות מעט גדול יותר (180%) המפריד יפה בין שורות הרשימה */
            color: #ffffff; /* צבע טקסט לבן */
        }
        
        /* עיצוב הדגשים בתוך הרשימה */
        .barca-list strong {
            color: #edbb00; /* מדגיש את ראשי הפרקים והנושאים בתוך הרשימה בצבע זהב */
        }
    </style>
</asp:Content>

<%-- פקד תוכן המזריק את כל המידע והמבנה הראשי של דף הבית ישירות לתוך ה-ContentPlaceHolder המרכזי של דף האב --%>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder1" Runat="Server">
    
    <%-- קופסת המעטפת של דף הבית המיישמת את חוקי העיצוב שהגדרנו למעלה --%>
    <div class="home-container">
        
        <%-- כותרת ברוכים הבאים ראשית --%>
        <h1 class="welcome-title">ברוכים הבאים לאתר הרשמי של אוהדי ברצלונה!</h1>
        <%-- תת כותרת עם הסלוגן הרשמי של המועדון --%>
        <p class="subtitle">הבית החם ברשת של המועדון הקטלוני הגדול בעולם - Més que un club</p>
        
        <%-- הצגת תמונת הבאנר המרכזית של שחקני הקבוצה --%>
        <img src="images/barca5.png" alt="שחקני ברצלונה" class="home-banner" />

        <%-- קו הפרדה אופקי מעוצב: דק מאוד (פיקסל 1) בעל שקיפות עדינה למראה נקי --%>
        <hr style="border: 0; height: 1px; background: rgba(255,255,255,0.2); margin: 30px 0;" />

        <%-- כותרת ופסקה ראשונה: מידע כללי והיסטורי על הקבוצה --%>
        <h3 class="section-title">על המועדון</h3>
        <p class="info-text">
            מועדון הכדורגל ברצלונה (FC Barcelona), הידוע גם בשם "בארסה", הוקם בשנת 1899 והפך עם השנים לאחד מסמליה התרבותיים והספורטיביים המוכרים ביותר של קטלוניה ושל עולם הספורט כולו. 
            המועדון חרט על דגלו את המוטו <strong>"יותר ממועדון"</strong>, בזכות המחויבות החברתית שלו, הערכים הספורטיביים והסגנון הייחודי שמזוהה איתו לאורך הדורות.
        </p>

        <%-- כותרת ורשימה לא ממוספרת (ul): מציגה לגולש את חלקי האתר השונים --%>
        <h3 class="section-title">מה תוכלו למצוא באתר שלנו?</h3>
        <ul class="barca-list">
            <li><strong>גלריית תמונות מרהיבה:</strong> רגעים בלתי נשכחים, חגיגות שערים ותמונות מהאצטדיון הביתי.</li>
            <li><strong>מידע על הקבוצה:</strong> היסטוריה עשירה, שחקני עבר והווה, ותארים של המועדון.</li>
            <li><strong>אזור אישי לאוהדים:</strong> מערכת הרשמה והתחברות מתקדמת למשתמשים רשומים ומנהלים.</li>
            <li><strong>עדכונים חמים:</strong> כל מה שקורה במועדון בזמן אמת.</li>
        </ul>

        <%-- כותרת ופסקה אחרונה: הישגי המועדון ומטרת בניית האתר --%>
        <h3 class="section-title">היסטוריה ותארים בקצרצר</h3>
        <p class="info-text">
            ברצלונה היא אחת הקבוצות המעוטרות ביותר בכדורגל העולמי. בארון הגביעים של המועדון ניתן למצוא עשרות אליפויות ספרד (לה ליגה), גביעי המלך, וכמובן זכיות היסטוריות בליגת האלופות. האתר הזה נבנה כדי לחגוג את האהבה שלנו לקבוצה ולספק מקום מפגש דיגיטלי לכל אוהד ואוהדת בארץ.
        </p>

        <%-- פסקת סיום איחולי גלישה בעיצוב מקומי (In-line Style) בצבע זהב מודגש עם צל שחור --%>
        <p style="margin-top: 40px; font-weight: bold; font-size: 20px; color: #edbb00; text-shadow: 1px 1px 2px black;">
            שתהיה גלישה מהנה ו... Visca el Barça! 🔵🔴
        </p>
    </div>

</asp:Content>